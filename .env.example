# Required: an OpenRouter key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Optional: any LiteLLM model name, and OpenRouter fallback models (comma-separated).
# AGENT_MODEL=openrouter/deepseek/deepseek-v4-flash-0731
# AGENT_FALLBACK_MODELS=openai/gpt-oss-120b

# Optional: send traces, metrics and logs to Grafana (`make observability`, then http://localhost:3000).
# Docker Compose sets these for you.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=getnet-agents

# Optional: the operator API (GET /tickets, POST /tickets/{number}/answer) is off without a token.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# OPERATOR_TOKEN=

# Optional: messages per merchant per minute (default 20), and the database of sessions, tickets and the
# rate limit (default: a SQLite file; Docker Compose uses Postgres).
# RATE_LIMIT_PER_MINUTE=20
# DATABASE_URL=sqlite+aiosqlite:///var/getnet.db
# POSTGRES_PASSWORD=

# Optional: webhooks. The operators get each new ticket; the back end of the merchant app gets each answer of a
# person, to send a push notification. Each request is signed with WEBHOOK_SECRET (header X-Signature).
# OPERATOR_WEBHOOK_URL=
# MERCHANT_WEBHOOK_URL=
# WEBHOOK_SECRET=

# Optional: the decision model of the tag and of the faithfulness judge (OpenRouter Decisions API).
# DECISION_MODEL=microsoft/microsoft-decision-1
